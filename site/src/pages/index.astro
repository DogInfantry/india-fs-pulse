---
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';
import EChart from '../components/EChart.astro';
import SlopeLines from '../components/charts/SlopeLines.astro';
import GapMatrix from '../components/GapMatrix.astro';
import ExecSummary from '../components/ExecSummary.astro';
import Answer from '../components/Answer.astro';
import Contact from '../components/Contact.astro';
import Marimekko from '../components/charts/Marimekko.astro';
import Waterfall from '../components/charts/Waterfall.astro';
import ValuePool from '../components/charts/ValuePool.astro';
import RangeBar from '../components/charts/RangeBar.astro';
import Slopegraph from '../components/charts/Slopegraph.astro';
import SmallMultiples from '../components/charts/SmallMultiples.astro';
import Workbench from '../components/Workbench.astro';
import Monogram from '../components/Monogram.astro';
import BrandMark from '../components/BrandMark.astro';
import { getCollection } from 'astro:content';
import Scrolly from '../components/Scrolly.astro';

import hero from '../data/upi_monetisation.json';
import split from '../data/chart_category_split.json';
import mdr from '../data/chart_mdr_bridge.json';
import nim from '../data/chart_nim_slope.json';
import spread from '../data/chart_bank_spread.json';
import nps from '../data/chart_nps_episodes.json';
import stateGap from '../data/chart_state_gap.json';
import unit from '../data/chart_unit_economics.json';
import trend from '../data/kpi_upi_trend.json';
import rail from '../data/chart_rail_cost.json';
import structure from '../data/chart_market_structure.json';
import shareTrend from '../data/chart_share_trend.json';
import hhi from '../data/chart_hhi.json';
import bridge from '../data/chart_growth_bridge.json';
import shelf from '../data/chart_fund_shelf.json';
import inclusion from '../data/chart_inclusion.json';
import marketView from '../data/chart_market_view.json';
import pixShape from '../data/chart_pix_shape.json';
import pixMigration from '../data/chart_pix_migration.json';
import pixProducts from '../data/chart_pix_products.json';
import pixFraud from '../data/chart_pix_fraud.json';
import bizModels from '../data/chart_business_models.json';
import valuePool from '../data/chart_value_pool.json';
import fiscalAsk from '../data/chart_fiscal_ask.json';
import cardsControl from '../data/chart_cards_control.json';
import acceptance from '../data/chart_acceptance.json';
import cardsTrend from '../data/chart_cards_trend.json';
import marginTrail from '../data/chart_margin_trajectory.json';
import meta from '../data/pipeline_meta.json';
import answer from '../data/answer.json';

const pc = (v: number, dp = 1) => `${(v * 100).toFixed(dp)}%`;
const inr = (v: number) =>
  v >= 1e12 ? `₹${(v / 1e12).toFixed(2)} lakh cr`
  : v >= 1e7 ? `₹${(v / 1e7).toLocaleString('en-IN', { maximumFractionDigits: 0 })} cr`
  : `₹${Math.round(v).toLocaleString('en-IN')}`;

const merchant = split.series.find((s) => s.category === 'Retail')!;
const p2p = split.series.find((s) => s.category === 'P2P')!;
const PERIOD = hero.period;
const SOURCE_PULSE = `PhonePe Pulse, ${PERIOD}. PhonePe's own transactions, not all of UPI. Accessed 2026-08-20.`;

/* ---- Exhibit 1 (hero): volume share against value share, by leg ---- */
const cats = split.series.map((s) => s.category);
const optSplit = {
  legend: { data: ['Share of transactions', 'Share of value'] },
  grid: { top: 34, left: 8, right: 46, bottom: 4, containLabel: true },
  xAxis: { type: 'value', max: 0.8, axisLabel: { formatter: (v: number) => `${Math.round(v * 100)}%` },
           splitLine: { lineStyle: { color: 'rgba(255,255,255,0.05)' } }, axisLine: { show: false } },
  yAxis: { type: 'category', data: cats, axisTick: { show: false }, axisLine: { show: false } },
  tooltip: { trigger: 'axis', axisPointer: { type: 'shadow' },
             valueFormatter: (v: number) => `${(v * 100).toFixed(1)}%` },
  series: [
    { name: 'Share of transactions', type: 'bar', data: split.series.map((s) => s.volume_share),
      label: { show: true, position: 'right', color: '#A6B0BE', fontSize: 11,
               formatter: (p: any) => `${(p.value * 100).toFixed(1)}%` } },
    { name: 'Share of value', type: 'bar', data: split.series.map((s) => s.value_share),
      itemStyle: { color: '#5B6673' },
      label: { show: true, position: 'right', color: '#6E7987', fontSize: 11,
               formatter: (p: any) => `${(p.value * 100).toFixed(1)}%` } },
  ],
};

/* ---- Exhibit 2: what an MDR would be worth on the merchant leg ---- */
const optMdr = {
  grid: { top: 26, left: 8, right: 16, bottom: 4, containLabel: true },
  xAxis: { type: 'category', data: mdr.scenarios.map((s) => s.rate === '0bps' ? '0bps (today)' : s.rate),
           axisTick: { show: false } },
  yAxis: { type: 'value', name: '₹ crore per quarter', nameTextStyle: { color: '#6E7987', fontSize: 11 },
           splitLine: { lineStyle: { color: 'rgba(255,255,255,0.05)' } } },
  tooltip: { trigger: 'axis', valueFormatter: (v: number) => `₹${Number(v).toLocaleString('en-IN')} cr` },
  series: [{
    type: 'bar', barWidth: '46%',
    data: mdr.scenarios.map((s, i) => ({
      value: s.revenue_cr,
      itemStyle: { color: i === 0 ? '#C02734' : '#5B6673', opacity: i === 0 ? 1 : 0.85 },
    })),
    label: { show: true, position: 'top', color: '#A6B0BE', fontSize: 11,
             formatter: (p: any) => p.value === 0 ? '₹0' : `₹${Number(p.value).toLocaleString('en-IN')} cr` },
  }],
};

/* ---- Exhibit 3: the decade of volume, with the data seam made visible ---- */
const months = trend.map((r: any) => r.month);
const mirror = trend.map((r: any) => (r.provenance === 'npci_ckan_mirror' ? r.volume_mn : null));
const manual = trend.map((r: any) => (r.provenance === 'npci_manual' ? r.volume_mn : null));
const seamIndex = trend.findIndex((r: any) => r.provenance === 'npci_manual');
if (seamIndex > 0) mirror[seamIndex] = trend[seamIndex].volume_mn;   // join the two lines
const optTrend = {
  legend: { data: ['Open CKAN mirror', 'Transcribed from NPCI'] },
  grid: { top: 34, left: 8, right: 16, bottom: 4, containLabel: true },
  xAxis: { type: 'category', data: months, axisTick: { show: false },
           axisLabel: { interval: 11, color: '#6E7987', fontSize: 10 } },
  yAxis: { type: 'value', name: 'transactions, million/month',
           nameTextStyle: { color: '#6E7987', fontSize: 11 },
           splitLine: { lineStyle: { color: 'rgba(255,255,255,0.05)' } } },
  tooltip: { trigger: 'axis', valueFormatter: (v: number) => v ? `${Number(v).toLocaleString('en-IN')} mn` : '-' },
  series: [
    { name: 'Open CKAN mirror', type: 'line', data: mirror, showSymbol: false, smooth: 0.15,
      lineStyle: { width: 2, color: '#5B6673' }, areaStyle: { color: 'rgba(91,102,115,0.12)' } },
    { name: 'Transcribed from NPCI', type: 'line', data: manual, showSymbol: false, smooth: 0.15,
      lineStyle: { width: 2.5, color: '#C02734' }, areaStyle: { color: 'rgba(192,39,52,0.10)' } },
  ],
};

/* ---- Exhibit 5: what banks earn against what they pay ---- */
const optSpread = {
  legend: { data: ['Yield on assets', 'Cost of funds', 'Net interest margin'] },
  grid: { top: 34, left: 8, right: 16, bottom: 4, containLabel: true },
  xAxis: { type: 'category', data: spread.series.map((s) => s.cohort), axisTick: { show: false } },
  yAxis: { type: 'value', axisLabel: { formatter: '{value}%' },
           splitLine: { lineStyle: { color: 'rgba(255,255,255,0.05)' } } },
  tooltip: { trigger: 'axis', valueFormatter: (v: number) => `${Number(v).toFixed(2)}%` },
  series: [
    { name: 'Yield on assets', type: 'bar', itemStyle: { color: '#5B6673' },
      data: spread.series.map((s) => +s.yield_on_assets.toFixed(2)) },
    { name: 'Cost of funds', type: 'bar', itemStyle: { color: '#1F7A8C' },
      data: spread.series.map((s) => +s.cost_of_funds.toFixed(2)) },
    { name: 'Net interest margin', type: 'bar', itemStyle: { color: '#C02734' },
      data: spread.series.map((s) => +s.nim.toFixed(2)),
      label: { show: true, position: 'top', color: '#A6B0BE', fontSize: 11, formatter: '{c}%' } },
  ],
};

/* ---- Exhibit 6: merchant unit economics under each MDR scenario ---- */
const priced = unit.scenarios.filter((s) => s.rate !== '0bps');
const optUnit = {
  grid: { top: 26, left: 8, right: 16, bottom: 4, containLabel: true },
  xAxis: { type: 'category', data: ['0bps (today)', ...priced.map((s) => s.rate)], axisTick: { show: false } },
  yAxis: { type: 'value', name: '₹ per merchant per year',
           nameTextStyle: { color: '#6E7987', fontSize: 11 },
           splitLine: { lineStyle: { color: 'rgba(255,255,255,0.05)' } } },
  tooltip: { trigger: 'axis', valueFormatter: (v: number) => `₹${Number(v).toLocaleString('en-IN')}` },
  series: [{
    type: 'bar', barWidth: '46%',
    data: [{ value: 0, itemStyle: { color: '#C02734' } },
           ...priced.map((s) => ({ value: Math.round(s.revenue_per_merchant_yr_inr), itemStyle: { color: '#5B6673' } }))],
    label: { show: true, position: 'top', color: '#A6B0BE', fontSize: 11,
             formatter: (p: any) => `₹${Number(p.value).toLocaleString('en-IN')}` },
  }],
};

/* ---- Exhibit 7: episode-level NPS (SYNTHETIC panel) ---- */
const optNps = {
  legend: { data: nps.series.map((s) => s.cohort) },
  grid: { top: 34, left: 8, right: 24, bottom: 4, containLabel: true },
  xAxis: { type: 'value', min: -60, max: 60, axisLabel: { formatter: '{value}' },
           splitLine: { lineStyle: { color: 'rgba(255,255,255,0.05)' } } },
  yAxis: { type: 'category', data: nps.episodes, axisTick: { show: false }, axisLine: { show: false } },
  tooltip: { trigger: 'axis', axisPointer: { type: 'shadow' },
             valueFormatter: (v: number) => `NPS ${v > 0 ? '+' : ''}${v}` },
  series: nps.series.map((s, i) => ({
    name: s.cohort, type: 'bar',
    itemStyle: { color: ['#C02734', '#1F7A8C', '#5B6673'][i % 3] },
    data: s.values,
  })),
};

/* ---- Exhibit 15: merchant intensity against merchant ticket, by state ----
   Both axes are now independent variables. The previous version plotted share
   of transactions against average ticket and coloured by an "intensity index"
   that was algebraically identical to the y-axis, so the colour carried no
   information at all. Merchant share is measured, not derived. */
const MIN_STATE = stateGap.min_share_for_extremes;
const natMerchant = stateGap.national_merchant_volume_share;
const material = stateGap.states.filter((s) => s.volume_share >= MIN_STATE);
const mRank = [...material].sort((a, b) => b.merchant_volume_share - a.merchant_volume_share);
const mHigh = mRank[0];
const mLow = mRank[mRank.length - 1];
const optStates = {
  grid: { top: 26, left: 8, right: 24, bottom: 4, containLabel: true },
  xAxis: { type: 'value', name: 'merchant share of the state’s own transactions',
           nameLocation: 'middle', nameGap: 28, nameTextStyle: { color: '#6E7987', fontSize: 11 },
           scale: true,
           axisLabel: { formatter: (v: number) => `${(v * 100).toFixed(0)}%` },
           splitLine: { lineStyle: { color: 'rgba(255,255,255,0.05)' } } },
  yAxis: { type: 'value', name: 'merchant average ticket, ₹', scale: true,
           nameTextStyle: { color: '#6E7987', fontSize: 11 },
           splitLine: { lineStyle: { color: 'rgba(255,255,255,0.05)' } } },
  tooltip: {
    trigger: 'item',
    formatter: (p: any) =>
      `<b>${p.data[2]}</b><br/>${(p.data[0] * 100).toFixed(1)}% of its transactions are merchant<br/>` +
      `merchant avg ticket ₹${Number(p.data[1]).toLocaleString('en-IN')}<br/>` +
      `${(p.data[3] * 100).toFixed(2)}% of national transactions`,
  },
  series: [{
    type: 'scatter',
    symbolSize: (d: any) => 8 + Math.sqrt(d[3]) * 60,
    itemStyle: { color: (p: any) => (p.data[0] >= natMerchant ? '#C02734' : '#1F7A8C'), opacity: 0.8 },
    data: material.map((s) => [s.merchant_volume_share, Math.round(s.merchant_avg_ticket_inr),
                               s.state, s.volume_share]),
    markLine: {
      silent: true, symbol: 'none',
      lineStyle: { color: '#5B6673', type: 'dashed', width: 1 },
      label: { formatter: `national ${(natMerchant * 100).toFixed(0)}%`,
               color: '#6E7987', fontSize: 10, position: 'insideEndTop' },
      data: [{ xAxis: natMerchant }],
    },
  }],
};

/* ---- Exhibit: what the rail costs, and who pays ---- */
const railYears = rail.years;
const lastRail = [...railYears].reverse().find((y) => y.effective_bps != null)!;
const optRail = {
  grid: { top: 52, left: 8, right: 8, bottom: 4, containLabel: true },
  legend: { top: 0, textStyle: { color: '#A6B0BE', fontSize: 11 }, icon: 'roundRect' },
  tooltip: { trigger: 'axis' },
  xAxis: { type: 'category', data: railYears.map((y) => `FY${y.fy}`),
           axisTick: { show: false }, axisLabel: { color: '#6E7987', fontSize: 10 } },
  yAxis: [
    { type: 'value', name: 'Rs crore paid', nameTextStyle: { color: '#6E7987', fontSize: 11 },
      splitLine: { lineStyle: { color: 'rgba(255,255,255,0.05)' } } },
    { type: 'value', name: 'bps', max: 33, nameTextStyle: { color: '#6E7987', fontSize: 11 },
      splitLine: { show: false } },
  ],
  series: [
    { name: 'Incentive paid', type: 'bar',
      /* The budgeted year is drawn hollow: it is an appropriation, not a payout. */
      data: railYears.map((y) => ({ value: y.payout_cr,
        itemStyle: { color: y.status === 'actual' ? '#1F7A8C' : 'rgba(31,122,140,0.30)',
                     borderColor: '#1F7A8C', borderWidth: y.status === 'actual' ? 0 : 1.2,
                     borderType: 'dashed' } })) },
    { name: 'Blended rate on all merchant value', type: 'line', yAxisIndex: 1,
      /* connectNulls false: the last year has no comparable rate, and drawing
         through the gap would invent one. */
      data: railYears.map((y) => y.effective_bps), connectNulls: false,
      lineStyle: { width: 2.5, color: '#C02734' }, itemStyle: { color: '#C02734' },
      markLine: { silent: true, symbol: 'none',
        label: { color: '#A6B0BE', fontSize: 10, formatter: '{b}', position: 'insideEndTop' },
        lineStyle: { color: '#6E7987', type: 'dashed' },
        data: [
          { yAxis: rail.statutory_rate_bps, name: `statutory ${rail.statutory_rate_bps}bps, eligible transactions only` },
          { yAxis: rail.npci_permitted_mdr_bps, name: `NPCI permits ${rail.npci_permitted_mdr_bps}bps; statute sets it to zero` },
        ] } },
  ],
};

/* ---- Market structure helpers ---- */
const leaders = structure.apps.filter((a) => a.app !== 'All other apps').slice(0, 2);
const top2 = structure.top2_volume_share;
const capMoveBn = structure.cap_gap_txns_mn / 1000;   // computed in analysis/06, not here
/* A slopegraph compares two endpoints on shared axes, so every line has to span
   the same window. An app that entered NPCI's published table late has no
   observation at the first month, and the `?? 0` this used to carry invented one:
   a fabricated zero, which rule 1 forbids. Late entrants appear in the small
   multiples above instead, where a short history reads honestly. */
const slopeSeries = shareTrend.series
  .filter((s) => s.values[0] != null && s.values.at(-1) != null)
  .slice(0, 5)
  .map((s) => ({ label: s.app, start: s.values[0]! * 100, end: s.values.at(-1)! * 100 }));

/* ---- Exhibit: concentration over time ---- */
const optHhi = {
  grid: { top: 26, left: 8, right: 16, bottom: 4, containLabel: true },
  /* A time axis, not a category one. The series thins from six-monthly to
     monthly, so drawing the months evenly spaced compressed two years into the
     same width as the last seven months and the decline read far steeper than
     it is. Rule 9: show the seam. */
  xAxis: { type: 'time', axisTick: { show: false },
           axisLabel: { color: '#6E7987', fontSize: 10, formatter: '{yyyy}-{MM}' } },
  yAxis: { type: 'value', name: 'HHI', min: 2500,
           nameTextStyle: { color: '#6E7987', fontSize: 11 },
           splitLine: { lineStyle: { color: 'rgba(255,255,255,0.05)' } } },
  tooltip: { trigger: 'axis' },
  series: [{ type: 'line',
             data: hhi.months.map((m, i) => [`${m}-01`, hhi.values[i]]),
             smooth: 0.2, showSymbol: false,
             lineStyle: { width: 2.5, color: '#C02734' },
             areaStyle: { color: 'rgba(192,39,52,0.10)' } }],
};

/* ---- Exhibit: transactions per banked adult ---- */
// `!= null` not truthiness: a computed 0 is a real observation, and would vanish.
const incl = inclusion.series.filter((r) => r.txns_per_banked_adult_per_month != null && r.txns_per_banked_adult_per_month > 0);
const optInclusion = {
  grid: { top: 30, left: 8, right: 46, bottom: 4, containLabel: true },
  xAxis: { type: 'category', data: incl.map((r) => String(r.year)), axisTick: { show: false } },
  yAxis: { type: 'value', name: 'UPI transactions per banked adult per month',
           nameTextStyle: { color: '#6E7987', fontSize: 10 },
           splitLine: { lineStyle: { color: 'rgba(255,255,255,0.05)' } } },
  tooltip: { trigger: 'axis' },
  series: [{ type: 'bar', barWidth: '44%', itemStyle: { color: '#C02734' },
             data: incl.map((r) => r.txns_per_banked_adult_per_month),
             label: { show: true, position: 'top', color: '#A6B0BE', fontSize: 11 } }],
};

/* ---- Exhibit: the market's verdict on the margin franchise ---- */
const optMarketView = {
  grid: { top: 26, left: 8, right: 60, bottom: 4, containLabel: true },
  xAxis: { type: 'value', axisLabel: { formatter: (v) => `${Math.round(v * 100)}%` },
           splitLine: { lineStyle: { color: 'rgba(255,255,255,0.05)' } } },
  yAxis: { type: 'category', axisTick: { show: false }, axisLine: { show: false },
           data: marketView.series.map((s) => s.cohort) },
  tooltip: { trigger: 'axis', axisPointer: { type: 'shadow' },
             valueFormatter: (v) => `${(v * 100).toFixed(0)}%` },
  series: [{ type: 'bar', barWidth: '48%',
             data: marketView.series.map((s, i) => ({ value: s.median_price_return,
               itemStyle: { color: i === 0 ? '#5B6673' : '#C02734' } })),
             label: { show: true, position: 'right', color: '#A6B0BE', fontSize: 11,
                      formatter: (p) => `${(p.value * 100).toFixed(0)}%` } }],
};

/* ---- Exhibit: the fund shelf ---- */
const optShelf = {
  legend: { data: ['Listed schemes', 'Distinct strategies'] },
  grid: { top: 34, left: 8, right: 16, bottom: 4, containLabel: true },
  xAxis: { type: 'category', axisTick: { show: false },
           data: shelf.by_asset_class.map((r) => r.asset_class),
           axisLabel: { color: '#8A94A6', fontSize: 10, rotate: 22 } },
  yAxis: { type: 'value', splitLine: { lineStyle: { color: 'rgba(255,255,255,0.05)' } } },
  tooltip: { trigger: 'axis', axisPointer: { type: 'shadow' } },
  series: [
    { name: 'Listed schemes', type: 'bar', itemStyle: { color: '#5B6673' },
      data: shelf.by_asset_class.map((r) => r.schemes) },
    { name: 'Distinct strategies', type: 'bar', itemStyle: { color: '#C02734' },
      data: shelf.by_asset_class.map((r) => r.strategies) },
  ],
};


/* ---- Exhibit: the same shape on two rails ---- */
const optPixShape = {
  grid: { top: 42, left: 8, right: 16, bottom: 4, containLabel: true },
  legend: { top: 0, textStyle: { color: '#A6B0BE', fontSize: 11 }, icon: 'roundRect' },
  tooltip: { trigger: 'axis' },
  xAxis: { type: 'category', data: pixShape.rails.map((r) => r.label),
           axisTick: { show: false }, axisLabel: { color: '#6E7987', fontSize: 10 } },
  yAxis: { type: 'value', axisLabel: { formatter: '{value}%', color: '#6E7987', fontSize: 10 },
           splitLine: { lineStyle: { color: 'rgba(255,255,255,0.05)' } } },
  series: [
    { name: 'Share of transactions', type: 'bar', barGap: '10%',
      data: pixShape.rails.map((r) => +(r.volume_share * 100).toFixed(1)),
      itemStyle: { color: '#C02734' } },
    { name: 'Share of value', type: 'bar',
      data: pixShape.rails.map((r) => +(r.value_share * 100).toFixed(1)),
      itemStyle: { color: '#1F7A8C' } },
  ],
};

/* ---- Exhibit: Brazil's merchant leg migrated the same way ---- */
/* A time axis, not a category axis: the series is 70 consecutive months and the
   x position has to carry the elapsed time rather than the row number. */
const pixMigPoint = (vals: number[]) =>
  pixMigration.months.map((m, i) => [`${m}-01`, +(vals[i] * 100).toFixed(2)]);
const optPixMigration = {
  grid: { top: 42, left: 8, right: 16, bottom: 4, containLabel: true },
  legend: { top: 0, textStyle: { color: '#A6B0BE', fontSize: 11 }, icon: 'roundRect' },
  tooltip: { trigger: 'axis' },
  xAxis: { type: 'time', axisLabel: { color: '#6E7987', fontSize: 10 } },
  yAxis: { type: 'value', axisLabel: { formatter: '{value}%', color: '#6E7987', fontSize: 10 },
           splitLine: { lineStyle: { color: 'rgba(255,255,255,0.05)' } } },
  series: [
    { name: 'Merchant share of transactions', type: 'line', showSymbol: false,
      data: pixMigPoint(pixMigration.volume_share),
      lineStyle: { width: 2.5, color: '#C02734' }, itemStyle: { color: '#C02734' },
      markLine: { silent: true, symbol: 'none',
        label: { color: '#A6B0BE', fontSize: 10, formatter: '{b}', position: 'insideEndTop' },
        lineStyle: { color: '#6E7987', type: 'dashed' },
        data: [{ yAxis: +(pixMigration.india_merchant_volume_share * 100).toFixed(1),
                 name: `India ${(pixMigration.india_merchant_volume_share * 100).toFixed(0)}%, ${pixMigration.india_period}` }] } },
    { name: 'Merchant share of value', type: 'line', showSymbol: false,
      data: pixMigPoint(pixMigration.value_share),
      lineStyle: { width: 2, color: '#1F7A8C' }, itemStyle: { color: '#1F7A8C' } },
  ],
};

/* ---- Exhibit: the layers built on top of the free rail ---- */
/* Every series carries nulls before its launch month, and connectNulls stays false:
   drawing through the gap would assert the product existed and did nothing. */
const PIX_PRODUCT_COLOUR = ['#C02734', '#1F7A8C', '#C98A2E', '#7C5CA8'];
const optPixProducts = {
  grid: { top: 42, left: 8, right: 16, bottom: 4, containLabel: true },
  legend: { top: 0, textStyle: { color: '#A6B0BE', fontSize: 11 }, icon: 'roundRect' },
  tooltip: { trigger: 'axis' },
  xAxis: { type: 'time', axisLabel: { color: '#6E7987', fontSize: 10 } },
  yAxis: { type: 'value', name: '% of merchant transactions',
           nameTextStyle: { color: '#6E7987', fontSize: 11 },
           axisLabel: { formatter: '{value}%', color: '#6E7987', fontSize: 10 },
           splitLine: { lineStyle: { color: 'rgba(255,255,255,0.05)' } } },
  series: pixProducts.series.map((sr, i) => ({
    name: sr.label, type: 'line', showSymbol: false, connectNulls: false,
    data: pixProducts.months.map((m, j) => [
      `${m}-01`, sr.values[j] == null ? null : +(sr.values[j]! * 100).toFixed(3),
    ]),
    lineStyle: { width: 2, color: PIX_PRODUCT_COLOUR[i % PIX_PRODUCT_COLOUR.length] },
    itemStyle: { color: PIX_PRODUCT_COLOUR[i % PIX_PRODUCT_COLOUR.length] },
  })),
};

/* ---- Exhibit: the disclosure asymmetry ---- */
const optPixFraud = {
  grid: { top: 52, left: 8, right: 8, bottom: 4, containLabel: true },
  legend: { top: 0, textStyle: { color: '#A6B0BE', fontSize: 11 }, icon: 'roundRect' },
  tooltip: { trigger: 'axis' },
  xAxis: { type: 'time', axisLabel: { color: '#6E7987', fontSize: 10 } },
  yAxis: [
    { type: 'value', name: 'per 100k txns', nameTextStyle: { color: '#6E7987', fontSize: 11 },
      splitLine: { lineStyle: { color: 'rgba(255,255,255,0.05)' } } },
    { type: 'value', name: '% returned', nameTextStyle: { color: '#6E7987', fontSize: 11 },
      splitLine: { show: false } },
  ],
  series: [
    { name: 'Accepted fraud disputes per 100k transactions', type: 'line', showSymbol: false,
      data: pixFraud.months.map((m, i) => [`${m}-01`, pixFraud.accepted_per_100k_txns[i]]),
      lineStyle: { width: 2.5, color: '#C02734' }, itemStyle: { color: '#C02734' } },
    { name: 'Share of disputed value returned', type: 'line', yAxisIndex: 1, showSymbol: false,
      data: pixFraud.months.map((m, i) => [`${m}-01`, pixFraud.returned_pct[i]]),
      lineStyle: { width: 2, color: '#1F7A8C' }, itemStyle: { color: '#1F7A8C' } },
  ],
};

/* ---- Exhibit: what each business model actually earns ---- */
const bizRows = bizModels.companies;
/* The state's payout is the first 'actual' row of the value pool, so the callout and
   the exhibit cannot disagree about which figure they mean. */
const statePaidCr = valuePool.rows.find((r) => r.kind === 'actual')!.value_cr;
const subsidyShare = (statePaidCr / valuePool.permitted_pool_cr) * 100;
const optBizModels = {
  grid: { top: 52, left: 8, right: 8, bottom: 4, containLabel: true },
  legend: { top: 0, textStyle: { color: '#A6B0BE', fontSize: 11 }, icon: 'roundRect' },
  tooltip: { trigger: 'axis' },
  xAxis: { type: 'category', data: bizRows.map((r) => r.company),
           axisTick: { show: false }, axisLabel: { color: '#6E7987', fontSize: 10 } },
  yAxis: [
    { type: 'value', name: 'Rs crore revenue', nameTextStyle: { color: '#6E7987', fontSize: 11 },
      splitLine: { lineStyle: { color: 'rgba(255,255,255,0.05)' } } },
    { type: 'value', name: 'net margin %', nameTextStyle: { color: '#6E7987', fontSize: 11 },
      splitLine: { show: false } },
  ],
  series: [
    /* The transaction business is the subject, so it carries the signal colour and
       everything else recedes to grey. */
    { name: 'Revenue', type: 'bar',
      data: bizRows.map((r) => ({ value: r.revenue_cr,
        itemStyle: { color: r.model === 'Transactions' ? '#C02734' : '#5B6673' } })) },
    { name: 'Net margin', type: 'line', yAxisIndex: 1, symbolSize: 9,
      data: bizRows.map((r) => r.net_margin_pct),
      lineStyle: { width: 2.5, color: '#1F7A8C' }, itemStyle: { color: '#1F7A8C' } },
  ],
};

/* ---- Exhibit: how each margin got where it is ---- */
const MODEL_COLOUR: Record<string, string> = {
  Transactions: '#C02734', Distribution: '#1F7A8C', Infrastructure: '#C98A2E',
};
const optMarginTrail = {
  grid: { top: 42, left: 8, right: 16, bottom: 4, containLabel: true },
  legend: { top: 0, textStyle: { color: '#A6B0BE', fontSize: 11 }, icon: 'roundRect' },
  tooltip: { trigger: 'axis' },
  xAxis: { type: 'category', data: marginTrail.years.map((y) => `FY${y}`),
           axisTick: { show: false }, axisLabel: { color: '#6E7987', fontSize: 10 } },
  yAxis: { type: 'value', axisLabel: { formatter: '{value}%', color: '#6E7987', fontSize: 10 },
           splitLine: { lineStyle: { color: 'rgba(255,255,255,0.05)' } } },
  /* connectNulls false: a company that had not listed yet has no margin, and a line
     drawn through that gap would assert one. */
  series: marginTrail.series.map((sr) => ({
    name: sr.company, type: 'line', connectNulls: false, symbolSize: 7,
    data: sr.values,
    lineStyle: { width: sr.model === 'Transactions' ? 2.8 : 1.8,
                 color: MODEL_COLOUR[sr.model] ?? '#5B6673' },
    itemStyle: { color: MODEL_COLOUR[sr.model] ?? '#5B6673' },
  })),
};

/* ---- Exhibit: the priced rail against the free one ---- */
const cardRail = cardsControl.rails.find((r) => r.priced)!;
const upiRail = cardsControl.rails.find((r) => !r.priced)!;
const optCardsControl = {
  grid: { top: 42, left: 8, right: 16, bottom: 4, containLabel: true },
  legend: { top: 0, textStyle: { color: '#A6B0BE', fontSize: 11 }, icon: 'roundRect' },
  tooltip: { trigger: 'axis' },
  xAxis: { type: 'category', data: cardsControl.rails.map((r) => r.rail),
           axisTick: { show: false }, axisLabel: { color: '#6E7987', fontSize: 11 } },
  yAxis: { type: 'value', axisLabel: { formatter: '{value}%', color: '#6E7987', fontSize: 10 },
           splitLine: { lineStyle: { color: 'rgba(255,255,255,0.05)' } } },
  series: [
    { name: 'Share of transactions between the two rails', type: 'bar', barGap: '10%',
      data: [+(cardsControl.card_volume_share * 100).toFixed(1),
             +((1 - cardsControl.card_volume_share) * 100).toFixed(1)],
      itemStyle: { color: '#C02734' } },
    { name: 'Share of value', type: 'bar',
      data: [+(cardsControl.card_value_share * 100).toFixed(1),
             +((1 - cardsControl.card_value_share) * 100).toFixed(1)],
      itemStyle: { color: '#1F7A8C' } },
  ],
};

/* ---- Exhibit: where a merchant can be paid ---- */
const optAcceptance = {
  grid: { top: 26, left: 8, right: 60, bottom: 4, containLabel: true },
  tooltip: { trigger: 'axis' },
  xAxis: { type: 'value', axisLabel: { color: '#6E7987', fontSize: 10 },
           splitLine: { lineStyle: { color: 'rgba(255,255,255,0.05)' } } },
  yAxis: { type: 'category', data: [...acceptance.points].reverse().map((p) => p.label),
           axisTick: { show: false }, axisLabel: { color: '#A6B0BE', fontSize: 11 } },
  /* Deliberately linear. The free rail dwarfing the priced ones IS the finding, and a
     log axis would flatter the terminals by hiding two orders of magnitude. */
  series: [{ type: 'bar',
    data: [...acceptance.points].reverse().map((p) => ({ value: Math.round(p.count / 1e6),
      itemStyle: { color: p.priced ? '#5B6673' : '#C02734' } })) }],
};

/* ---- Exhibit: is the split standing, or was it one month? ---- */
const optCardsTrend = {
  grid: { top: 42, left: 8, right: 8, bottom: 4, containLabel: true },
  legend: { top: 0, textStyle: { color: '#A6B0BE', fontSize: 11 }, icon: 'roundRect' },
  tooltip: { trigger: 'axis' },
  xAxis: { type: 'category', data: cardsTrend.months, axisTick: { show: false },
           axisLabel: { color: '#6E7987', fontSize: 10 } },
  yAxis: [
    { type: 'value', name: 'card share of value, %', min: 0, max: 12,
      nameTextStyle: { color: '#6E7987', fontSize: 11 },
      splitLine: { lineStyle: { color: 'rgba(255,255,255,0.05)' } } },
    { type: 'value', name: 'QR per terminal', min: 0,
      nameTextStyle: { color: '#6E7987', fontSize: 11 }, splitLine: { show: false } },
  ],
  series: [
    { name: 'Card share of value', type: 'line', symbolSize: 9,
      data: cardsTrend.card_value_share.map((v) => +(v * 100).toFixed(2)),
      lineStyle: { width: 2.8, color: '#C02734' }, itemStyle: { color: '#C02734' } },
    { name: 'UPI QR codes per card terminal', type: 'line', yAxisIndex: 1, symbolSize: 9,
      data: cardsTrend.qr_per_terminal,
      lineStyle: { width: 2, color: '#1F7A8C' }, itemStyle: { color: '#1F7A8C' } },
  ],
};

/* ---- Executive summary ---- */
const nimGap = Math.round(nim.gap_bps.at(-1));
const wrapperX = shelf.listed_schemes / shelf.distinct_strategies;
const execAnswer = `India's payments rails have separated volume from value and priced the busy half at zero <em>to whoever accepts the payment</em>. `
  + `Merchant payments are <strong>${pc(merchant.volume_share, 0)} of transactions but ${pc(merchant.value_share, 0)} of the rupees</strong>, `
  + `and merchant is the only leg an MDR could touch. Zero is not free: the state pays acquiring banks `
  + `<strong>${lastRail.effective_bps.toFixed(1)} basis points</strong> to hold it there, and that rate is falling. `
  + `The market is concentrated at the same time as it is unmonetised, `
  + `which is why the share cap cannot bind, and why the investable business here is <strong>distribution, not transactions</strong>.`;
const execFindings = [
  { n: pc(merchant.volume_share, 0) + ' / ' + pc(merchant.value_share, 0),
    claim: 'Merchant payments carry the transactions; P2P carries the rupees. The busy leg earns nothing.',
    href: '#module-a' },
  { n: pc(top2, 0),
    claim: `Two apps intermediate four in five transactions, and both breach the ${(structure.cap * 100).toFixed(0)}% cap due this December.`,
    href: '#module-structure' },
  { n: capMoveBn.toFixed(1) + 'bn',
    claim: 'Transactions a month that would have to change app for the cap to bind. It will not bind.',
    href: '#module-structure' },
  { n: lastRail.effective_bps.toFixed(1) + 'bps',
    claim: 'What zero MDR actually costs, paid by the taxpayer to acquiring banks, and falling every year without a decision.',
    href: '#module-cost' },
  { n: nimGap + 'bps',
    claim: 'The private-bank margin advantage, and it splits almost evenly between pricing and funding.',
    href: '#module-banking' },
  { n: '₹0',
    claim: `${(unit.merchants / 1e6).toFixed(1)}M merchants, ${inr(unit.gmv_per_merchant_quarter_inr)} of GMV each per quarter, no payment revenue.`,
    href: '#module-diligence' },
  { n: wrapperX.toFixed(1) + '×',
    claim: "Wrappers per real strategy on India’s fund shelf. Most of the product count is packaging.",
    href: '#module-wealth' },
];

/* The memo grid reads its titles from the memos themselves. Retyping them here is
   exactly how the page and the generator drift, and two of them already had: the
   survey and geography cards quoted titles the analysis layer stopped writing.
   Order and kicker are editorial, so those stay here; the guard means a memo that
   is never given a card breaks the build instead of shipping unreachable. */
const MEMO_KICKER: Record<string, string> = {
  'pov-upi-monetization': 'Point of view',
  'pov-rail-cost': 'Cost of the rail',
  'pov-market-structure': 'Market structure',
  'pov-deposit-war': 'Sector scan',
  'diligence-merchant-payments': 'Diligence',
  'survey-nps-episodes': 'Survey',
  'gap-geographic': 'Gap analysis',
  'wealth-fund-shelf': 'Wealth',
  'pov-pix-comparator': 'Comparator',
  'pov-business-models': 'What it earns',
  'pov-value-pool': 'The prize',
  'pov-cards-control': 'Control group',
};
const memoOrder = Object.keys(MEMO_KICKER);
const memos = (await getCollection('insights'))
  .sort((a, b) => memoOrder.indexOf(a.id) - memoOrder.indexOf(b.id));
const unlisted = memos.filter((m) => !(m.id in MEMO_KICKER)).map((m) => m.id);
if (unlisted.length) {
  throw new Error(`memo grid: ${unlisted.join(', ')} has no card, so it would ship reachable only from the sitemap. Add it to MEMO_KICKER.`);
}

---

<Base
  title="India FS Pulse: the UPI monetisation reckoning"
  description="India built the world's largest real-time payments network and priced it at zero. A code-driven scan, point of view, diligence simulation and survey analysis of Indian financial services."
>
  <header class="hero">
    <div class="wrap">
      <p class="kicker">Financial Services &middot; Point of view &middot; {PERIOD}</p>
      <h1>
        India built the world's largest payments network.<br />
        <em>It priced the busy half at zero.</em>
      </h1>
      <p class="lede">
        In {PERIOD}, merchant payments were <strong>{pc(merchant.volume_share)} of every transaction
        but only {pc(merchant.value_share)} of the rupees</strong>. Person-to-person transfers were
        the mirror image. The merchant leg is the only one a discount rate could ever be charged
        on, and under zero-MDR it earns nothing for whoever accepts the payment. Zero is not
        free, though: the state pays acquiring banks <strong>{lastRail.effective_bps.toFixed(1)}
        basis points</strong> to hold it there, and that rate is falling.
      </p>
      <dl class="stats">
        <div><dt>Merchant share of transactions</dt><dd>{pc(merchant.volume_share)}</dd></div>
        <div><dt>Merchant share of value</dt><dd>{pc(merchant.value_share)}</dd></div>
        <div><dt>Average merchant ticket</dt><dd>{inr(merchant.avg_ticket_inr)}</dd></div>
        <div><dt>Payment revenue at 0bps</dt><dd class="zero">₹0</dd></div>
      </dl>
      <p class="tags">
        <span>Industry scan</span><span>Point of view</span><span>PE diligence</span>
        <span>Survey analytics</span><span>Interactive dashboards</span>
      </p>
    </div>
  </header>

  <main id="main">
    <div class="wrap">
      <Scrolly
        categories={hero.categories}
        period={PERIOD}
        merchantAvgTicket={hero.merchant_avg_ticket_inr}
      />
    </div>

    <div class="wrap"><Answer governing={answer.governing} pillars={answer.pillars} /></div>
    <div class="wrap"><ExecSummary answer={execAnswer} findings={execFindings} /></div>

    <section class="wrap module" id="module-a">
      <h2 class="section-head"><span>A</span> Payments landscape and the monetisation gap</h2>
      <div class="grid">
        <Figure
          kicker="Exhibit 1 · Volume against value"
          title={`Merchant payments carry ${pc(merchant.volume_share, 0)} of transactions but ${pc(merchant.value_share, 0)} of the rupees`}
          subtitle={`P2P is the mirror image: ${pc(p2p.volume_share, 0)} of transactions, ${pc(p2p.value_share, 0)} of value. Volume and value have separated.`}
          source={SOURCE_PULSE}
          download="/data/chart_category_split.csv"
          wide
        >
          <EChart id="c-split" option={optSplit} height={260} />
        </Figure>

        <Figure
          kicker="Exhibit 2 · The revenue gap"
          title="Every rate other than the one in force would produce real revenue"
          subtitle={`Quarterly revenue the merchant leg would generate at each MDR, on ${mdr.merchant_gmv_lakh_cr.toFixed(2)} lakh crore of merchant GMV. The rate in force is 0bps.`}
          source={SOURCE_PULSE}
        download="/data/chart_mdr_bridge.csv"
        >
          <EChart id="c-mdr" option={optMdr} />
        </Figure>

        <Figure
          kicker="Exhibit 3 · Ten years of volume"
          title="Volume compounds without pause, and the series shows exactly where its data came from"
          subtitle="The open mirror of NPCI's series stops in August 2023. Later months were transcribed from NPCI's own table, and are coloured differently rather than silently merged."
          source="NPCI monthly product statistics: open CKAN mirror to 2023-08, then transcribed from npci.org.in on 2026-08-20. Four months NPCI does not publish in its ten-row table are left as gaps, not interpolated."
        download="/data/kpi_upi_trend.csv"
        >
          <EChart id="c-trend" option={optTrend} />
        </Figure>

        <Figure
          kicker="Exhibit 4 · Growth bridge"
          title={bridge.note}
          subtitle="Where the extra transactions came from. The merchant leg is the one a discount rate could be charged on."
          source={SOURCE_PULSE}
          download="/data/chart_growth_bridge.csv"
          wide
        >
          <Waterfall steps={bridge.steps} unit={bridge.unit} highlight={bridge.highlight} />
        </Figure>
      </div>
    </section>

    <section class="wrap module" id="module-cost">
      <h2 class="section-head"><span>B</span> What the rail costs, and who pays</h2>
      <Figure
        kicker="Exhibit 5 · The subsidy"
        title={`Zero MDR costs ${lastRail.effective_bps.toFixed(1)} basis points, paid by the taxpayer, and the rate is falling`}
        subtitle="Bars are the incentive the government actually paid acquiring banks. The line is that payment over ALL national merchant value, so both sides are measured. The final year is an approved outlay, not a payout, and carries no rate: its appropriation covers twelve months while the published value base covers ten."
        source="Press Information Bureau, Ministry of Finance, 24 March 2025. Transcribed in a browser: PIB serves HTTP 403 to scripted requests and publishes these figures as chart images. Computed by analysis/08_rail_cost.py."
        download="/data/chart_rail_cost.csv"
        wide
      >
        <EChart id="c-rail" option={optRail} height={300} />
      </Figure>
      <p class="callout">
        <b>Why this changes the question:</b> the merchant leg is not unpriced, it is
        priced at {lastRail.effective_bps.toFixed(1)}bps and billed to the exchequer. The
        appropriation is set in rupees while the base it covers compounds in percent, so
        the effective rate falls every year without anyone deciding that it should.
        <a href="/insights/pov-rail-cost">Read the memo and what it cannot know →</a>
      </p>
    </section>

    <section class="wrap module" id="module-pool">
      <h2 class="section-head"><span>C</span> The prize, in rupees</h2>
      <Figure
        kicker="Exhibit 6 · The pool that does not exist"
        title={`Priced at the ${valuePool.permitted_bps}bps NPCI itself permits, the merchant leg would be worth ${valuePool.times_rail_revenue.toFixed(1)}x the entire revenue of India's largest listed payments company`}
        subtitle={`FY${valuePool.fy} national merchant value of Rs ${valuePool.base_lakh_cr.toFixed(1)} lakh crore, priced at each rate. Dashed bars are money that does not exist; solid bars exist. Not a forecast: an MDR actually introduced would change behaviour rather than simply multiply out.`}
        source="PIB national UPI value split, and filed accounts via Yahoo Finance. Every bar is a published rate times a published base. Computed by analysis/11_value_pool.py."
        download="/data/chart_value_pool.csv"
        wide
      >
        <ValuePool rows={valuePool.rows} permittedBps={valuePool.permitted_bps} fy={valuePool.fy} />
      </Figure>

      <Figure
        kicker="Exhibit 7 · The ask nobody printed"
        title={`Holding the subsidy rate steady would cost between ${(fiscalAsk.gap_low_cr / 1000).toFixed(1)}k and ${(fiscalAsk.gap_high_cr / 1000).toFixed(1)}k crore more than was appropriated`}
        subtitle={`Section B recommends indexing the outlay to merchant volume and never sizes it. This is that number, as a band rather than a figure: the published merchant base for FY${fiscalAsk.fy} covers ${fiscalAsk.months} months, so the low end treats it as a year and the high end scales it pro rata.`}
        source="PIB, Ministry of Finance. A range because a ten-month base annualised is an assumption, not a measurement, which is rule 12."
        download="/data/chart_fiscal_ask.csv"
        wide
      >
        <RangeBar
          low={fiscalAsk.low_cr}
          high={fiscalAsk.high_cr}
          actual={fiscalAsk.appropriated_cr}
          lowLabel="Ten-month base as is"
          highLabel="Scaled pro rata"
          actualLabel={`Appropriated FY${fiscalAsk.fy}`}
          caption={`Holding ${fiscalAsk.hold_rate_bps.toFixed(2)}bps is the target section B names. The gap between what that costs and what was voted is the fiscal ask, and it has never appeared in this report until now.`}
        />
      </Figure>
      <p class="callout">
        <b>Why this reframes everything above it:</b> the merchant leg is not a small
        business earning nothing. It is a large business that is not permitted to charge,
        and the state buys back {subsidyShare.toFixed(0)}%
        of the price it forgoes. Every recommendation in this report should be sized against
        what operators actually earn, not against this pool.
        <a href="/insights/pov-value-pool">Read the memo and what a pool is not →</a>
      </p>
    </section>

    <section class="wrap module" id="module-cards">
      <h2 class="section-head"><span>D</span> The rail that is allowed to charge</h2>
      <div class="grid">
        <Figure
          kicker="Exhibit 8 · The control group"
          title={`Cards hold ${(cardsControl.card_volume_share * 100).toFixed(1)}% of the transactions but ${(cardsControl.card_value_share * 100).toFixed(1)}% of the value: a price does not kill a rail, it segments it`}
          subtitle={`${cardsControl.month}, same country, same merchants, same regulator, and only cards may charge a merchant discount rate. Average ticket ₹${cardRail.avg_ticket_inr.toLocaleString('en-IN')} on cards against ₹${upiRail.avg_ticket_inr.toLocaleString('en-IN')} on UPI, ${cardsControl.ticket_multiple}x. Cash withdrawal excluded: it is not a merchant payment.`}
          source="RBI Bank-wise ATM/PoS/Card Statistics, national Total row, transcribed by hand because RBI document links return an interstitial to a script. That Total reconciled against its 63 bank rows at 0.00%. Computed by analysis/13_cards_control.py."
          download="/data/chart_cards_control.csv"
          wide
        >
          <EChart id="c-cards" option={optCardsControl} height={280} />
        </Figure>

        <Figure
          kicker="Exhibit 9 · Where a merchant can be paid"
          title={`There are ${acceptance.qr_per_terminal.toFixed(0)} UPI QR codes for every card terminal in the country`}
          subtitle="Millions of acceptance points at month end. A terminal is hardware that costs money and carries a fee on every swipe; a QR code is a printed sticker that carries neither. The axis is linear on purpose."
          source="RBI Bank-wise ATM/PoS/Card Statistics, national Total row."
          download="/data/chart_acceptance.csv"
          wide
        >
          <EChart id="c-acceptance" option={optAcceptance} height={200} />
        </Figure>
        <Figure
          kicker="Exhibit 10 · Standing, not incidental"
          title={`The split holds: cards move within ${cardsTrend.value_share_range_pp} of a percentage point of value across every month transcribed, while QR acceptance pulls further away`}
          subtitle={`${cardsTrend.months[0]} to ${cardsTrend.months.at(-1)}, three separate workbooks. The red line is the priced rail share of value between the two rails; the teal line is UPI QR codes per card terminal, which went from ${cardsTrend.qr_per_terminal[0].toFixed(0)} to ${cardsTrend.qr_per_terminal.at(-1)!.toFixed(0)} in three months. Three points show the split is standing; they do not make a trend.`}
          source="RBI Bank-wise ATM/PoS/Card Statistics, one hand-transcribed workbook per month, each reconciled against its own bank rows. UPI from the NPCI series."
          download="/data/chart_cards_trend.csv"
          wide
        >
          <EChart id="c-cards-trend" option={optCardsTrend} height={280} />
        </Figure>
      </div>
      <p class="callout">
        <b>This is the cleanest test in the report:</b> everything except the price is held
        constant, and the priced rail did not die. It kept the large ticket and lost the
        volume. That gives the merchant leg volume-heavy, value-light shape a mechanism
        rather than only a description, and it bounds what re-pricing UPI could ever move.
        <a href="/insights/pov-cards-control">Read the memo and what it will not price →</a>
      </p>
    </section>

    <section class="wrap module" id="module-structure">
      <h2 class="section-head"><span>E</span> Market structure and the share cap</h2>
      <ul class="entities" aria-label="Apps analysed in this section">
