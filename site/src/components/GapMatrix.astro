---
/**
 * Gap analyser: JD-to-artefact traceability.
 *
 * Rows are the requirements as written in the job description. Coverage is a
 * Harvey ball, the convention this exact table has used in consulting decks for
 * decades - a geometric glyph, read at a glance, no colour needed. It replaced a
 * row of coloured pill badges reading "Demonstrated" / "Partial", which is the
 * house style of generated UI rather than of a coverage matrix.
 *
 * The artefact column is a link, not a paragraph. The artefact argues its own
 * case one click away. A caveat is kept ONLY where coverage is short of full,
 * because that is where the reader is owed one - and the "Not covered" row is
 * kept deliberately: a self-assessment that only ever says "full" is not an
 * assessment.
 */
const rows = [
  { need: 'Drive open-ended research', level: 'full',
    artefact: 'Seven-module scan, seven live sources', href: '/#module-a' },
  { need: 'Create industry points of view', level: 'full',
    artefact: 'pov-upi-monetization.md', href: '/insights/pov-upi-monetization' },
  { need: 'Sector and industry scans', level: 'full',
    artefact: 'Banking, market structure, wealth', href: '/insights/pov-deposit-war' },
  { need: 'Summarise key themes, trends and challenges', level: 'full',
    artefact: 'Every memo closes with a “so what”', href: '/insights/pov-upi-monetization' },
  { need: 'Survey analytics', level: 'partial',
    artefact: 'Episode-level NPS', href: '/insights/survey-nps-episodes',
    note: 'Method is real; the panel is a seeded synthetic one, because episode benchmarks are proprietary.' },
  { need: 'Private equity diligence support', level: 'full',
    artefact: 'diligence-merchant-payments.md', href: '/insights/diligence-merchant-payments' },
  { need: 'Build FS data assets and IP', level: 'full',
    artefact: 'Reproducible pipeline, generated provenance', href: '/methodology' },
  { need: 'Client-ready visualisation dashboards (e.g. Tableau)', level: 'partial',
    artefact: 'Linked cartogram, table and detail panel', href: '/#workbench',
    note: 'Bespoke exhibits and an interactive workbench, all in code — but not in Tableau itself.' },
  { need: 'Structured communication of insights', level: 'full',
    artefact: 'Answer-first: every title is the finding', href: '/#module-a' },
  { need: 'Quantify a live policy question', level: 'full',
    artefact: 'The 30% share cap, priced', href: '/insights/pov-market-structure' },
  { need: 'Deal with ambiguity; tackle diligence questions', level: 'full',
    artefact: 'Explicit ambiguity register', href: '/insights/diligence-merchant-payments' },
  { need: 'Python / R / Alteryx knowledge', level: 'full',
    artefact: 'Python end to end, zero credentials', href: '/methodology' },
  { need: 'Advanced Microsoft Excel and PowerPoint', level: 'none',
    artefact: 'Not demonstrated', href: null,
    note: 'Scoped as web-only. The pipeline emits tidy CSV, so a model workbook and a deck are a short addition.' },
];

const LABEL = { full: 'Demonstrated', partial: 'Partial', none: 'Not covered' } as const;
type Level = keyof typeof LABEL;

const counts = { full: 0, partial: 0, none: 0 };
rows.forEach((r) => counts[r.level as Level]++);
const pct = (n: number) => (n / rows.length) * 100;
---
<div class="matrix">
  <div class="summary">
    <div class="propbar" role="img"
         aria-label={`${counts.full} of ${rows.length} requirements demonstrated, ${counts.partial} partial, ${counts.none} not covered.`}>
      <i class="full" style={`width:${pct(counts.full)}%`}></i>
      <i class="partial" style={`width:${pct(counts.partial)}%`}></i>
      <i class="none" style={`width:${pct(counts.none)}%`}></i>
    </div>
    <p class="key">
      <span><b>{counts.full}</b> demonstrated</span>
      <span><b>{counts.partial}</b> partial</span>
      <span><b>{counts.none}</b> not covered</span>
      <span class="of">of {rows.length} requirements</span>
    </p>
  </div>

  <table>
    <thead>
      <tr>
        <th scope="col">What the job description asks for</th>
        <th scope="col" class="mid">Coverage</th>
        <th scope="col">Artefact</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <th scope="row" class="need">{r.need}</th>
          <td class="mid">
            <svg class:list={['ball', r.level]} viewBox="0 0 16 16" width="15" height="15"
                 role="img" aria-label={LABEL[r.level as Level]}>
              <circle cx="8" cy="8" r="6.6" fill="none" stroke="currentColor" stroke-width="1.4" />
              {r.level === 'full' && <circle cx="8" cy="8" r="6.6" fill="currentColor" />}
              {r.level === 'partial' && <path d="M8 1.4 A6.6 6.6 0 0 0 8 14.6 Z" fill="currentColor" />}
            </svg>
          </td>
          <td class="artefact">
            {r.href
              ? <a href={r.href}>{r.artefact}</a>
              : <span class="muted">{r.artefact}</span>}
            {r.note && <span class="note">{r.note}</span>}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .matrix { overflow-x: auto; }

  .summary { margin-bottom: 1.2rem; }
  .propbar { display: flex; height: 6px; border-radius: 999px; overflow: hidden;
             background: var(--surface-2); border: 1px solid var(--line); max-width: 460px; }
  .propbar i { display: block; height: 100%; }
  .propbar i.full { background: var(--text-2); }
  .propbar i.partial { background: var(--text-3); }
  .propbar i.none { background: var(--signal); }
  .key { display: flex; flex-wrap: wrap; gap: 1rem; margin: 0.55rem 0 0;
         color: var(--text-3); font-size: 0.72rem; max-width: 460px; }
  .key b { color: var(--text); font-variant-numeric: tabular-nums; }
  .key .of { margin-left: auto; }

  table { width: 100%; border-collapse: collapse; font-size: 0.83rem; min-width: 560px; }
  th[scope='col'] { text-align: left; color: var(--text-3); font-weight: 600; font-size: 0.68rem;
                    text-transform: uppercase; letter-spacing: 0.07em; padding: 0 0.75rem 0.6rem 0; }
  td, th[scope='row'] { padding: 0.7rem 0.75rem 0.7rem 0;
                        border-top: 1px solid var(--line-soft); vertical-align: top; }
  .mid { text-align: center; width: 92px; padding-right: 0; }
  .need { color: var(--text); font-weight: 600; width: 40%; text-align: left; }

  /* Harvey balls: one geometric glyph, no colour required to read it. */
  .ball { display: block; margin: 1px auto 0; }
  .ball.full { color: var(--text); }
  .ball.partial { color: var(--text-2); }
  .ball.none { color: var(--signal-text); }

  .artefact { color: var(--text-2); line-height: 1.5; }
  .artefact a { color: var(--text-2); text-decoration-color: var(--signal-line);
                text-underline-offset: 3px; }
  .artefact a:hover { color: var(--text); }
  .muted { color: var(--text-3); }
  .note { display: block; margin-top: 0.28rem; color: var(--text-3); font-size: 0.73rem;
          line-height: 1.45; max-width: 46ch; }
</style>
