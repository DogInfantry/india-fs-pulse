---
/**
 * Coverage and limits: what this report covers, what it half covers, and what it
 * does not touch at all.
 *
 * Coverage is a Harvey ball, the convention this exact table has used in consulting
 * decks for decades: a geometric glyph, read at a glance, no colour needed. It
 * replaced a row of coloured pill badges reading "Demonstrated" / "Partial", which
 * is the house style of generated UI rather than of a coverage matrix.
 *
 * The artefact column is a link, not a paragraph, so the artefact argues its own
 * case one click away. A note is kept ONLY where coverage is short of full, because
 * that is where the reader is owed one. The "Not covered" rows are the point of the
 * exhibit rather than an embarrassment in it: a scan that only ever reports full
 * coverage is not a scan.
 */
const rows = [
  { need: 'Retail payments economics', level: 'full',
    artefact: 'The monetisation gap, four exhibits', href: '/insights/pov-upi-monetization' },
  { need: 'Payments market structure', level: 'full',
    artefact: 'Shares, concentration, the cap priced', href: '/insights/pov-market-structure' },
  { need: 'What the rail costs to run', level: 'partial',
    artefact: 'The subsidy, measured against national merchant value', href: '/insights/pov-rail-cost',
    note: 'The state subsidy is measured. Fraud is not: losses are answered in Parliament on perimeters that do not line up with each other or with the fiscal year, and stitching them into one series would be a false comparison rather than a finding.' },
  { need: 'Banking margins and funding', level: 'full',
    artefact: 'Public against private, four fiscal years', href: '/insights/pov-deposit-war' },
  { need: 'Private equity diligence framing', level: 'full',
    artefact: 'A recommendation and an ambiguity register', href: '/insights/diligence-merchant-payments' },
  { need: 'Geographic segmentation', level: 'partial',
    artefact: 'All 36 states and union territories', href: '/insights/gap-geographic',
    note: 'One quarter, and the merchant mix is a single operator’s. A second operator could invert the ranking, and nothing open publishes one.' },
  { need: 'Wealth and asset management', level: 'partial',
    artefact: 'The fund shelf, schemes against strategies', href: '/insights/wealth-fund-shelf',
    note: 'Scheme counts, not assets. The public AMFI file carries no AUM, so none of this can yet be stated as a fee pool.' },
  { need: 'Survey analytics', level: 'partial',
    artefact: 'Episode-level NPS', href: '/insights/survey-nps-episodes',
    note: 'The method and the instrument are real; the panel is seeded and synthetic, because episode benchmarks are proprietary. The chart says so as well.' },
  { need: 'Interactive analysis', level: 'full',
    artefact: 'Linked cartogram, table and detail panel', href: '/#workbench' },
  { need: 'Reproducible sourcing', level: 'full',
    artefact: 'Generated provenance, no figure typed by hand', href: '/methodology' },
  { need: 'Consumer credit and lending', level: 'none',
    artefact: 'Not covered', href: null,
    note: 'The diligence memo concludes that the loan is the P&L, and then cannot size it. No open, current, India-wide series does. This is the largest gap on the page.' },
  { need: 'Insurance', level: 'none',
    artefact: 'Not covered', href: null,
    note: 'IRDAI publishes to PDF only. There is no machine-readable series to fetch, so nothing is claimed.' },
  { need: 'Comparison with other instant rails', level: 'partial',
    artefact: 'Brazil’s Pix, measured against the same question', href: '/insights/pov-pix-comparator',
    note: 'One comparator, not a survey of rails. Pix is the only instant rail at national scale that publishes a merchant leg its own regulator labels, so the shape can be compared without deriving it; every other candidate would have to be inferred. Brazil’s fraud series also stops four months before its transaction series, so the two are not read against each other.' },
];

const LABEL = { full: 'Covered', partial: 'Partial', none: 'Not covered' } as const;
type Level = keyof typeof LABEL;

const counts = { full: 0, partial: 0, none: 0 };
rows.forEach((r) => counts[r.level as Level]++);
const pct = (n: number) => (n / rows.length) * 100;
---
<div class="matrix">
  <div class="summary">
    <div class="propbar" role="img"
         aria-label={`${counts.full} of ${rows.length} areas covered in full, ${counts.partial} partial, ${counts.none} not covered.`}>
      <i class="full" style={`width:${pct(counts.full)}%`}></i>
      <i class="partial" style={`width:${pct(counts.partial)}%`}></i>
      <i class="none" style={`width:${pct(counts.none)}%`}></i>
    </div>
    <p class="key">
      <span><b>{counts.full}</b> covered</span>
      <span><b>{counts.partial}</b> partial</span>
      <span><b>{counts.none}</b> not covered</span>
      <span class="of">of {rows.length} areas</span>
    </p>
  </div>

  <table>
    <thead>
      <tr>
        <th scope="col">What this report covers</th>
        <th scope="col" class="mid">Coverage</th>
        <th scope="col">Artefact</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <th scope="row" class="need">{r.need}</th>
          <td class="mid">
            <svg class:list={['ball', r.level]} viewBox="0 0 16 16" width="15" height="15"
                 role="img" aria-label={LABEL[r.level as Level]}>
              <circle cx="8" cy="8" r="6.6" fill="none" stroke="currentColor" stroke-width="1.4" />
              {r.level === 'full' && <circle cx="8" cy="8" r="6.6" fill="currentColor" />}
              {r.level === 'partial' && <path d="M8 1.4 A6.6 6.6 0 0 0 8 14.6 Z" fill="currentColor" />}
            </svg>
          </td>
          <td class="artefact">
            {r.href
              ? <a href={r.href}>{r.artefact}</a>
              : <span class="muted">{r.artefact}</span>}
            {r.note && <span class="note">{r.note}</span>}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .matrix { overflow-x: auto; }

  .summary { margin-bottom: 1.2rem; }
  .propbar { display: flex; height: 6px; border-radius: 999px; overflow: hidden;
             background: var(--surface-2); border: 1px solid var(--line); max-width: 460px; }
  .propbar i { display: block; height: 100%; }
  .propbar i.full { background: var(--text-2); }
  .propbar i.partial { background: var(--text-3); }
  .propbar i.none { background: var(--signal); }
  .key { display: flex; flex-wrap: wrap; gap: 1rem; margin: 0.55rem 0 0;
         color: var(--text-3); font-size: 0.72rem; max-width: 460px; }
  .key b { color: var(--text); font-variant-numeric: tabular-nums; }
  .key .of { margin-left: auto; }

  table { width: 100%; border-collapse: collapse; font-size: 0.83rem; min-width: 560px; }
  th[scope='col'] { text-align: left; color: var(--text-3); font-weight: 600; font-size: 0.68rem;
                    text-transform: uppercase; letter-spacing: 0.07em; padding: 0 0.75rem 0.6rem 0; }
  td, th[scope='row'] { padding: 0.7rem 0.75rem 0.7rem 0;
                        border-top: 1px solid var(--line-soft); vertical-align: top; }
  .mid { text-align: center; width: 92px; padding-right: 0; }
  .need { color: var(--text); font-weight: 600; width: 40%; text-align: left; }

  /* Harvey balls: one geometric glyph, no colour required to read it. */
  .ball { display: block; margin: 1px auto 0; }
  .ball.full { color: var(--text); }
  .ball.partial { color: var(--text-2); }
  .ball.none { color: var(--signal-text); }

  .artefact { color: var(--text-2); line-height: 1.5; }
  .artefact a { color: var(--text-2); text-decoration-color: var(--signal-line);
                text-underline-offset: 3px; }
  .artefact a:hover { color: var(--text); }
  .muted { color: var(--text-3); }
  .note { display: block; margin-top: 0.28rem; color: var(--text-3); font-size: 0.73rem;
          line-height: 1.45; max-width: 46ch; }
</style>
