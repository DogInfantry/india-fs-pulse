---
/**
 * The standard frame for every exhibit.
 *
 * The action-title convention lives here: `title` must state the FINDING, not
 * the contents. "Merchant payments are 64% of transactions but 23% of rupees",
 * never "Transaction split by category".
 */
interface Props {
  kicker: string;
  title: string;
  subtitle?: string;
  source: string;
  wide?: boolean;
  /* Path to this exhibit's own numbers, generated by docs/build_exhibit_csv.py from
     the same JSON the chart reads. The reproducibility claim is worth more at the
     point it is made than in a repository the reader has to go and clone. */
  download?: string;
}
const { kicker, title, subtitle, source, wide = false, download } = Astro.props;
---
<figure class:list={["fig", wide && "wide"]}>
  <figcaption>
    <p class="kicker">{kicker}</p>
    <h3 class="action-title">{title}</h3>
    {subtitle && <p class="subtitle">{subtitle}</p>}
  </figcaption>
  <div class="body"><slot /></div>
  <p class="source">
    {source}
    {download && (
      <a class="dl" href={download} download>Download this exhibit's data (CSV)</a>
    )}
  </p>
</figure>

<style>
  .fig {
    margin: 0;
    padding: clamp(1.1rem, 3vw, 1.75rem);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .fig.wide { grid-column: 1 / -1; }
  figcaption { margin-bottom: 0.9rem; }
  .body { min-height: 40px; }
  .source {
    margin: 1rem 0 0;
    padding-top: 0.7rem;
    border-top: 1px solid var(--line-soft);
    color: var(--text-3);
    font-size: 0.72rem;
    line-height: 1.5;
  }
  .dl {
    display: inline-block;
    margin-top: 0.45rem;
    color: var(--text-2);
    text-decoration-color: var(--signal-line);
    text-underline-offset: 3px;
  }
  .dl:hover { color: var(--text); }
</style>
